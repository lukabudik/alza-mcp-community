{
  "name": "alza-mcp-community",
  "mcpName": "io.github.lukabudik/alza-mcp-community",
  "version": "0.6.0",
  "description": "Unofficial Model Context Protocol server for Alza.cz — product search, details, reviews, and pickup points, plus the authenticated account, cart, checkout, order, and payment stack (mobile REST + legacy web WCF).",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "alza-mcp-community": "dist/index.js"
  },
  "files": [
    "dist",
    "scripts/postinstall.cjs",
    "scripts/cf-transport.py",
    "scripts/ensure-cf-venv.sh",
    "scripts/alza-auth-login.mjs",
    "scripts/alza-auth-login-noninteractive.mjs",
    "scripts/alza-auth-exchange.mjs",
    "scripts/alza-auth-refresh.mjs",
    "scripts/alza-auth-smoke.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc && node -e \"if (process.platform !== 'win32') require('node:fs').chmodSync('dist/index.js', 0o755)\"",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate:api": "tsx scripts/validate-api.ts",
    "eval": "tsx scripts/eval.ts",
    "pentest:app-action": "tsx scripts/pentest-app-action.ts",
    "pentest:app-action:python": "python3 scripts/pentest-app-action.py",
    "live:endpoint-matrix": "python3 scripts/live-endpoint-matrix.py",
    "live:user-journeys": "python3 scripts/live-user-journeys.py",
    "postinstall": "node scripts/postinstall.cjs",
    "setup:cf": "bash scripts/ensure-cf-venv.sh",
    "prepublishOnly": "npm run build",
    "version": "node scripts/sync-version.cjs && git add server.json mcpb/manifest.json src/server.ts",
    "version:check": "node scripts/sync-version.cjs --check",
    "auth:login": "node scripts/alza-auth-login.mjs",
    "auth:login:noninteractive": "node scripts/alza-auth-login-noninteractive.mjs",
    "auth:exchange": "node scripts/alza-auth-exchange.mjs",
    "auth:login:py": "python3 scripts/alza_auth_login.py",
    "auth:refresh": "node scripts/alza-auth-refresh.mjs",
    "auth:smoke": "node scripts/alza-auth-smoke.mjs",
    "live:e2e": "node scripts/e2e-order-payment.browser.mjs run",
    "test:contract": "vitest run test/registration-contract.test.ts",
    "test:docker": "bash scripts/docker-install-tests.sh",
    "live:e2e:node": "node scripts/e2e-order-payment.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "alza",
    "alza.cz",
    "ecommerce",
    "shopping",
    "claude",
    "anthropic",
    "ai",
    "agent"
  ],
  "author": "alza-mcp-community contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukabudik/alza-mcp-community.git"
  },
  "homepage": "https://github.com/lukabudik/alza-mcp-community#readme",
  "bugs": {
    "url": "https://github.com/lukabudik/alza-mcp-community/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "cheerio": "^1.0.0",
    "playwright": "^1.59.1",
    "undici": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12"
  }
}
